# YouTube Data API v3 keys (comma-separated for quota failover)
YOUTUBE_API_KEYS=your_key_1,your_key_2

# Backward-compatible single-key settings
YOUTUBE_API_KEY=your_key

# Optional Supabase configuration (leave blank for local-only mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel server-only Supabase administration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_EMAIL=ravirajesh988@gmail.com

# Client-side visibility only; authorization is always repeated on the server
VITE_ADMIN_EMAIL=ravirajesh988@gmail.com
