# YouTube Data API v3 keys (comma-separated for quota failover)
VITE_YOUTUBE_API_KEYS=your_browser_key_1,your_browser_key_2
YOUTUBE_API_KEYS=your_desktop_key_1,your_desktop_key_2

# Backward-compatible single-key settings
VITE_YOUTUBE_API_KEY=your_browser_key
YOUTUBE_API_KEY=your_desktop_key

# Optional Supabase configuration (leave blank for local-only mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
